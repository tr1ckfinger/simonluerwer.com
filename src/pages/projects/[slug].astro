---
import Base from '../../layouts/Base.astro';
import Lightbox from '../../components/Lightbox.astro';
import SeriesInfo from '../../components/SeriesInfo.astro';
import { getEntry, render } from 'astro:content';
import { getAlbums, cldUrl } from '../../lib/cloudinary';

export async function getStaticPaths() {
  const albums = await getAlbums();
  return albums.map((album) => ({
    params: { slug: album.slug },
    props: { album },
  }));
}

const { album } = Astro.props;

// Optional info/description block — see src/content.config.ts. Most
// albums won't have a matching file, which is fine: getEntry returns
// undefined and the block just doesn't render. Location/Date and
// Description are independent — a series can have either, both, or
// neither, and each renders only when present.
const infoEntry = await getEntry('albums', album.slug);
const infoContent = infoEntry ? await render(infoEntry) : null;
// Location is written by hand in the markdown file's frontmatter.
const location = infoEntry?.data.location;
const hasMeta = !!(location || infoEntry?.data.date);
const hasDescription = !!infoEntry?.body?.trim();

// Default back destination is the listing page. The back-arrow script
// in Base.astro overrides this client-side when the user arrived from
// the flat home grid (/) instead — so this is just the sensible
// fallback for direct loads / shared links.
const backHref = '/projects';

// SEO: per-series description + the album's own cover as OG image so
// link previews show the actual series, not a generic fallback.
const description = `${album.title} — a photo series by Simon Lürwer, photographer based in Hamburg, Germany. ${album.images.length} images.`;
const ogImage = cldUrl(album.cover.public_id, {
  w: 1200,
  h: 630,
  crop: 'fill',
  q: 'auto:best',
});
---

<Base
  title={`${album.title} — Simon Lürwer Photography`}
  description={description}
  ogImage={ogImage}
  albumHeader={{ title: album.title, backHref, count: album.images.length }}
  noindex={album.hidden}
>
  <div class="series-layout">
    {(hasMeta || hasDescription) && (
      <aside class="album-info">
        <SeriesInfo
          location={location}
          date={infoEntry?.data.date}
          hasDescription={hasDescription}
        >
          {infoContent && <infoContent.Content />}
        </SeriesInfo>
      </aside>
    )}

    <section class="justified">
      {album.images.map((img) => {
        const aspect = img.width / img.height;
        return (
          <figure
            class:list={['drop-in', { landscape: aspect > 1 }]}
            style={`--aspect: ${aspect}; flex-grow: ${aspect}; flex-basis: calc(${aspect} * var(--row-h)); aspect-ratio: ${aspect};`}
          >
            <img
              class="thumb img-fade"
              src={cldUrl(img.public_id, { w: 1600 })}
              data-full={cldUrl(img.public_id, { w: 3200, q: 'auto:best' })}
              data-zoom={cldUrl(img.public_id, { q: 'auto:best' })}
              alt=""
              loading="lazy"
              width={img.width}
              height={img.height}
            />
          </figure>
        );
      })}
      <i class="filler"></i>
      <i class="filler"></i>
      <i class="filler"></i>
      <i class="filler"></i>
    </section>
  </div>

  <Lightbox />
</Base>

<style>
  /* Two-column series layout on desktop: a text sidebar on the left
     (same left inset as the rest of the page — it's just the first
     flex child inside <main>, no extra margin) and the image grid
     beside it. Both columns scroll together — the sidebar is a plain
     flex item, not pinned.
     Below 900px there's no room for a comfortable sidebar next to a
     usable image grid, so it collapses to the original stacked
     layout — text above, images below. */
  .series-layout {
    display: flex;
    align-items: flex-start;
    gap: 54px;
  }
  .album-info {
    /* 380px (was 420px). Scrolls along with the image grid rather than
       staying pinned — both columns move together. */
    flex: 0 0 380px;
    padding-top: 8px;
    /* Fades in on arrival (same feel as the lightbox sidebar on the
       home grid) instead of appearing instantly before the images. */
    animation: info-in 800ms cubic-bezier(0.22, 1, 0.36, 1) 200ms both;
  }
  @keyframes info-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .album-info { animation: none; }
  }
  .justified {
    /* Sole flex child when there's no info sidebar — flex-basis: 0 +
       flex-grow: 1 make it fill the row exactly like a normal
       block-level element would, rather than sizing to content. */
    flex: 1 1 0;
    min-width: 0;
  }
  @media (max-width: 900px) {
    .series-layout {
      display: block;
    }
    .album-info {
      max-width: 640px;
    }
  }
  /* Location / Date / Description field typography lives in
     SeriesInfo.astro now (shared with the lightbox's copy of the same
     info) — nothing to style here beyond this sidebar's own layout,
     handled above. */

  /* Justified flex layout, identical to the home grid (index.astro) so
     the home feed and the inside-series pages share one rhythm —
     switching from / into /projects/<slug> doesn't read as "different
     design". Each figure expands by its aspect ratio to fill the row
     width; phantom .filler elements at the end keep the last row from
     stretching when it has fewer items than a full row. */
  /* Desktop --row-h is ~1.2× the home-grid values (260 → 312, 220 → 264)
     so once a viewer commits to a single series the images get a touch
     more room to breathe without dominating the layout. The gap
     between images is the same as the home grid's (18 / 10 / 6px), so
     the two views share one rhythm. Tablet and mobile keep the
     home-grid row heights so small screens don't get unwieldy. */
  .justified {
    padding-top: 8px;
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    --row-h: 312px;
  }
  @media (max-width: 1100px) { .justified { --row-h: 264px; } }
  @media (max-width: 900px) { .justified { --row-h: 190px; gap: 10px; } }
  @media (max-width: 500px) { .justified { --row-h: 160px; gap: 6px; } }
  .justified figure {
    margin: 0;
    overflow: hidden;
    background: var(--card-bg);
    min-width: 0;
  }
  .justified figure img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    cursor: pointer;
    transition: filter 380ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .justified figure img:hover {
    filter: brightness(var(--img-hover));
  }
  /* Phantom fillers absorb leftover slack on the last row so the row
     keeps natural sizing instead of stretching its items to fill width. */
  .justified .filler {
    flex-grow: 1000000000;
    flex-basis: 0;
    content: '';
    height: 0;
  }
  /* On mobile the flex justified layout's "last row stays at basis
     while other rows stretch" trick makes orphan items visibly smaller
     than the rows above. Swap in a 2-column CSS grid: every cell shares
     one column width, so orphans on the last row match the cells above.
     aspect-ratio: var(--aspect) keeps each image's true aspect, so
     landscapes stay landscape instead of getting cover-cropped to 3:4
     (the reason an earlier hardcoded `aspect-ratio: 3/4` grid was
     replaced). Hide the phantom fillers — grid auto-places real items
     into cells and the fillers would just take up dead cells.
     Landscape items (aspect > 1) span both columns so they get the
     full row width instead of sitting awkwardly in a half-column with
     a tall empty gap beside them. */
  @media (max-width: 500px) {
    .justified {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 6px;
    }
    .justified .filler { display: none; }
    .justified figure {
      width: 100%;
      height: auto;
      aspect-ratio: var(--aspect);
    }
    .justified figure.landscape {
      grid-column: span 2;
    }
  }
</style>
