---
import Base from '../layouts/Base.astro';
import { getAlbums, cldUrl, albumHref } from '../lib/cloudinary';

const all = await getAlbums();
// Hidden projects are tagged-out from the listing — direct URL still works.
const projects = all.filter((a) => !a.hidden);

// Pick the freshest project's cover for the link preview image.
const ogImage =
  projects.length > 0
    ? cldUrl(projects[0].cover.public_id, {
        w: 1200,
        h: 630,
        crop: 'fill',
        q: 'auto:best',
      })
    : undefined;

const description =
  'Selected work by Simon Lürwer — themed series and commissioned photography from Hamburg, Germany.';
---

<Base
  title="Work — Simon Lürwer Photography"
  description={description}
  ogImage={ogImage}
>
  <section class="grid">
    {projects.map((project) => (
      <a
        href={albumHref(project)}
        class="card drop-in"
      >
        <img
          class="img-fade"
          src={cldUrl(project.cover.public_id, { w: 1200, h: 1500, crop: 'fill' })}
          alt={project.title}
          loading="lazy"
        />
        <span class="title">{project.title}</span>
      </a>
    ))}
  </section>

  {projects.length === 0 && (
    <p class="empty">No work yet. Upload images to subfolders of Portfolio Projects/ in Cloudinary.</p>
  )}
</Base>

<style>
  /* Projects listing — same 4-up tile grid as the albums listing, kept
     identical so the two ways in (series vs themed/commissioned work)
     share one visual rhythm. Gaps mirror the inside-series spacing
     (3× home-grid) so listing the projects feels as deliberately
     spacious as viewing one. */
  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 54px;
    padding-top: 8px;
  }
  @media (max-width: 1200px) {
    .grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 900px) {
    .grid { gap: 30px; }
  }
  @media (max-width: 760px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 500px) {
    .grid { gap: 18px; }
  }
  .card {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--card-bg);
  }
  .card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: filter 380ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .card:hover img {
    filter: brightness(var(--img-hover));
  }
  /* Project name in the lower third of the cover, in Instrument Serif (self-
     hosted, see @font-face in Base.astro). A faint dark wash over the
     photo keeps white text legible on bright covers. */
  .card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.22);
    pointer-events: none;
  }
  .title {
    position: absolute;
    /* Sits in the lower third of the cover, centred within it, then
       nudged up by 8% of the cover height. */
    inset: auto 0 8% 0;
    height: 33.333%;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 18px;
    text-align: center;
    text-wrap: balance;
    color: #fff;
    font-family: 'Instrument Serif', Georgia, 'Times New Roman', serif;
    font-weight: 400;
    font-size: clamp(20px, 2vw, 31px);
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-shadow: 0 1px 18px rgba(0, 0, 0, 0.35);
    pointer-events: none;
  }
  @media (max-width: 760px) {
    .title { font-size: 18px; padding: 0 12px; }
  }
  .empty {
    color: var(--muted);
    padding: 80px 0;
    text-align: center;
  }
</style>
