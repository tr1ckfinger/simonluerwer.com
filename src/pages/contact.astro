---
import Base from '../layouts/Base.astro';
import { getEntry, render } from 'astro:content';

// Prose lives in src/content/about/about.md.
const entry = await getEntry('about', 'about');
const { Content } = entry ? await render(entry) : { Content: null };
---

<Base
  title="Contact — Simon Lürwer Photography"
  description="Contact Simon Lürwer, photographer based in Hamburg, Germany. Email, Instagram, location."
>
  <section class="page">
    <h1 class="visually-hidden">about me</h1>
    <img
      class="portrait"
      src="/portrait-1600.jpg"
      alt="Simon Lürwer"
      width="1434"
      height="1600"
    />
    <div class="body">
      <div class="prose">{Content && <Content />}</div>
      <dl class="fields">
        <dt>email</dt>
        <dd><a id="email-link" href="#" rel="noreferrer">simon [at] imgs.wtf</a></dd>
        <dt>instagram</dt>
        <dd><a href="https://instagram.com/tr1ckfinger" target="_blank" rel="noreferrer">@tr1ckfinger</a></dd>
        <dt>based in</dt>
        <dd>hamburg, germany</dd>
      </dl>
    </div>
  </section>

  <script is:inline>
    // JS-assembled mailto so the literal address never appears in the
    // page source. Drive-by scrapers that don't run JS see only the
    // placeholder text — most don't bother to de-obfuscate that, so
    // the address stays off spam lists. Real users get a working
    // clickable mailto link.
    //
    // TODO: this is a placeholder reusing the personal-site address
    // until luerwer.com is purchased and hello@luerwer.com is set up
    // via iCloud+ Custom Domain (same flow as imgs.wtf's email setup).
    // Swap the two string literals below once that's live.
    (() => {
      const link = document.getElementById('email-link');
      if (!link) return;
      const addr = 'simon' + '@' + 'imgs.wtf';
      link.href = 'mailto:' + addr;
      link.textContent = addr;
    })();
  </script>
</Base>

<style>
  /* Two-column layout: a portrait (forced 3:4, about the size of a
     portrait thumbnail on the home grid) on the left, the text on the
     right, both top-aligned. Stacks (image above text) below 900px. */
  .page {
    display: grid;
    grid-template-columns: 300px auto;
    column-gap: 96px;
    align-items: start;
    /* Centre the whole block in the space below the nav. */
    justify-content: center;
    align-content: center;
    min-height: calc(100vh - var(--nav-h, 56px) - 48px);
    padding: 24px 0;
  }
  .portrait {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: 50% 30%;
  }
  .body {
    max-width: 560px;
  }
  .body :global(.prose p) {
    color: var(--fg);
    line-height: 1.6;
    font-size: 19px;
    margin: 0 0 28px;
  }
  .fields {
    display: grid;
    grid-template-columns: max-content 1fr;
    row-gap: 12px;
    column-gap: 28px;
    margin: 0;
  }
  .fields dt {
    color: var(--muted);
    font-size: 15px;
    align-self: center;
  }
  .fields dd {
    margin: 0;
    font-size: 16px;
    color: var(--fg);
  }
  .fields a {
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
    transition: opacity 150ms ease;
  }
  .fields a:hover {
    opacity: 0.6;
  }
  /* Kept for screen readers / SEO — the nav already says "about me". */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  @media (max-width: 1100px) {
    .page { column-gap: 48px; }
  }
  @media (max-width: 900px) {
    .page {
      grid-template-columns: minmax(0, 420px);
      row-gap: 32px;
    }
    .portrait { max-width: 300px; margin-inline: auto; }
  }
  @media (max-width: 640px) {
    .body :global(.prose p) { font-size: 17px; margin-bottom: 24px; }
    .fields { column-gap: 20px; row-gap: 10px; }
    .fields dt { font-size: 14px; }
    .fields dd { font-size: 15px; }
  }
</style>
