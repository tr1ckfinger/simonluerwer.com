---
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  albumHeader?: { title: string; backHref: string; count: number };
  // When true, emits <meta name="robots" content="noindex, nofollow">
  // so search engines skip this page even if they discover the URL
  // (sitemap, accidental backlink, social share, etc.). Used for
  // unlisted ("hidden"-tagged) series pages — the URL still works but
  // shouldn't surface in Google results.
  noindex?: boolean;
}

// Default SEO copy. Each page can override description / ogImage with
// something more specific; the defaults catch the long tail.
const DEFAULT_DESCRIPTION =
  'Photography by Simon Lürwer — street photography, portraits, and personal projects from Hamburg, Germany. Fotografie aus Hamburg.';
const DEFAULT_OG_IMAGE = 'https://simonluerwer.com/portrait.jpg';

const {
  title = 'simonluerwer.com',
  description = DEFAULT_DESCRIPTION,
  ogImage = DEFAULT_OG_IMAGE,
  albumHeader,
  noindex = false,
} = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = path === '/';
const isProjects = path === '/projects';
const isContact = path === '/contact';

// Canonical URL — resolves against Astro.site (set in astro.config).
// Falls back to the request URL if Astro.site isn't configured.
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.href;

// JSON-LD Person schema describing Simon as the site owner. Google
// uses this to associate the site with a real person and surface
// "Simon Lürwer" knowledge-panel-style results.
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Simon Lürwer',
  alternateName: 'Simon',
  url: 'https://simonluerwer.com',
  image: 'https://simonluerwer.com/portrait.jpg',
  jobTitle: 'Photographer',
  description:
    'Photographer based in Hamburg, Germany. Street photography, portraits, and personal projects.',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Hamburg',
    addressCountry: 'DE',
  },
  sameAs: ['https://instagram.com/tr1ckfinger'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- The "-v2" suffix is a cache-bust: iOS Safari's OS-level favicon
         database (shared with Spotlight / Siri suggestions) hung onto
         an Astro-starter icon from an earlier deploy and refused to
         re-fetch from the same URL even after Website Data was cleared.
         Renaming the files forces a fresh fetch. -->
    <link rel="icon" type="image/svg+xml" href="/favicon-v2.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32-v2.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-v2.png" />
    <link
      rel="preload"
      href="/fonts/InstrumentSerif-Regular-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <!-- No <meta name="theme-color"> or <meta name="color-scheme">.
         Safari iOS samples the page content directly to tint its
         chrome; an explicit theme-color (especially one mutated on
         toggle) appears to conflict with the content sample and
         smear the chrome retint. frankmorlok.com omits both metas
         and the chrome follows its background-color transition
         frame-perfectly. -->
    <title>{title}</title>

    <!-- SEO: description is the single most important signal for
         Google's snippet generation. Keywords meta is largely ignored
         by Google in 2026 but still parsed by Bing / DuckDuckGo. -->
    {noindex && (
      <meta name="robots" content="noindex, nofollow" />
    )}
    <meta name="description" content={description} />
    <meta name="author" content="Simon Lürwer" />
    <meta
      name="keywords"
      content="Simon Lürwer, Photography Hamburg, Fotografie Hamburg, Foto Simon, Foto Winterhude, Street Photography Hamburg, Portrait Photography Hamburg, Fotograf Hamburg"
    />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph: link previews on iMessage, WhatsApp, Facebook,
         LinkedIn, Slack, etc. og:image should be ≥1200×630px and an
         absolute URL — Cloudinary transforms handle both. -->
    <meta property="og:site_name" content="simonluerwer.com" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="de_DE" />

    <!-- Twitter Card: separate spec from OG but most platforms fall
         back to OG. Specifying both maximises coverage. -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured data: tells Google "this site belongs to a real
         photographer named Simon Lürwer based in Hamburg". Powers the
         knowledge panel / rich result on name searches once Google
         has crawled and verified. -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />
  </head>
  <body>
    <header class="nav">
      <div class="nav-inner">
        <div class="nav-left">
          {albumHeader ? (
            <Fragment>
              <a href={albumHeader.backHref} class="back-arrow" aria-label="Back">←</a>
              <span class="brand">{albumHeader.title}</span>
            </Fragment>
          ) : (
            <a href="/" class="brand">simon lürwer</a>
          )}
        </div>
        <div class="nav-center">
          {albumHeader && <span class="count">{albumHeader.count} images</span>}
        </div>
        <div class="nav-right">
          <nav class="nav-links" aria-label="Primary">
            <a href="/" class:list={['nav-link', { active: isHome }]}>home</a>
            <a href="/projects" class:list={['nav-link', { active: isProjects }]}>work</a>
            <a href="/contact" class:list={['nav-link', { active: isContact }]}>about me</a>
          </nav>
          <button
            id="menu-toggle"
            class="menu-toggle"
            type="button"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <span></span><span></span>
          </button>
        </div>
      </div>
    </header>
    <div id="mobile-menu" class="mobile-menu" aria-hidden="true">
      <nav class="menu-primary" aria-label="Menu">
        <a href="/" style="--i: 0">home</a>
        <a href="/projects" style="--i: 1">work</a>
        <a href="/contact" style="--i: 2">about me</a>
      </nav>
      <div class="menu-secondary">
        <a href="/imprint" style="--i: 3">imprint</a>
        <a
          class="menu-ig"
          href="https://instagram.com/tr1ckfinger"
          target="_blank"
          rel="noreferrer"
          aria-label="Instagram"
          style="--i: 4"
        >
          <svg viewBox="0 0 1000 1000" fill="currentColor" aria-hidden="true"><path d="M295.42,6c-53.2,2.51-89.53,11-121.29,23.48-32.87,12.81-60.73,30-88.45,57.82S40.89,143,28.17,175.92c-12.31,31.83-20.65,68.19-23,121.42S2.3,367.68,2.56,503.46,3.42,656.26,6,709.6c2.54,53.19,11,89.51,23.48,121.28,12.83,32.87,30,60.72,57.83,88.45S143,964.09,176,976.83c31.8,12.29,68.17,20.67,121.39,23s70.35,2.87,206.09,2.61,152.83-.86,206.16-3.39S799.1,988,830.88,975.58c32.87-12.86,60.74-30,88.45-57.84S964.1,862,976.81,829.06c12.32-31.8,20.69-68.17,23-121.35,2.33-53.37,2.88-70.41,2.62-206.17s-.87-152.78-3.4-206.1-11-89.53-23.47-121.32c-12.85-32.87-30-60.7-57.82-88.45S862,40.87,829.07,28.19c-31.82-12.31-68.17-20.7-121.39-23S637.33,2.3,501.54,2.56,348.75,3.4,295.42,6m5.84,903.88c-48.75-2.12-75.22-10.22-92.86-17-23.36-9-40-19.88-57.58-37.29s-28.38-34.11-37.5-57.42c-6.85-17.64-15.1-44.08-17.38-92.83-2.48-52.69-3-68.51-3.29-202s.22-149.29,2.53-202c2.08-48.71,10.23-75.21,17-92.84,9-23.39,19.84-40,37.29-57.57s34.1-28.39,57.43-37.51c17.62-6.88,44.06-15.06,92.79-17.38,52.73-2.5,68.53-3,202-3.29s149.31.21,202.06,2.53c48.71,2.12,75.22,10.19,92.83,17,23.37,9,40,19.81,57.57,37.29s28.4,34.07,37.52,57.45c6.89,17.57,15.07,44,17.37,92.76,2.51,52.73,3.08,68.54,3.32,202s-.23,149.31-2.54,202c-2.13,48.75-10.21,75.23-17,92.89-9,23.35-19.85,40-37.31,57.56s-34.09,28.38-57.43,37.5c-17.6,6.87-44.07,15.07-92.76,17.39-52.73,2.48-68.53,3-202.05,3.29s-149.27-.25-202-2.53m407.6-674.61a60,60,0,1,0,59.88-60.1,60,60,0,0,0-59.88,60.1M245.77,503c.28,141.8,115.44,256.49,257.21,256.22S759.52,643.8,759.25,502,643.79,245.48,502,245.76,245.5,361.22,245.77,503m90.06-.18a166.67,166.67,0,1,1,167,166.34,166.65,166.65,0,0,1-167-166.34" transform="translate(-2.5 -2.5)" /></svg>
        </a>
      </div>
    </div>
    <main>
      <slot />
      <footer class="site-footer">
        <a class="footer-imprint" href="/imprint">Imprint</a>
        <div class="footer-icons">
          <a
            href="https://instagram.com/tr1ckfinger"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
          >
            <svg viewBox="0 0 1000 1000" fill="currentColor" aria-hidden="true"><path d="M295.42,6c-53.2,2.51-89.53,11-121.29,23.48-32.87,12.81-60.73,30-88.45,57.82S40.89,143,28.17,175.92c-12.31,31.83-20.65,68.19-23,121.42S2.3,367.68,2.56,503.46,3.42,656.26,6,709.6c2.54,53.19,11,89.51,23.48,121.28,12.83,32.87,30,60.72,57.83,88.45S143,964.09,176,976.83c31.8,12.29,68.17,20.67,121.39,23s70.35,2.87,206.09,2.61,152.83-.86,206.16-3.39S799.1,988,830.88,975.58c32.87-12.86,60.74-30,88.45-57.84S964.1,862,976.81,829.06c12.32-31.8,20.69-68.17,23-121.35,2.33-53.37,2.88-70.41,2.62-206.17s-.87-152.78-3.4-206.1-11-89.53-23.47-121.32c-12.85-32.87-30-60.7-57.82-88.45S862,40.87,829.07,28.19c-31.82-12.31-68.17-20.7-121.39-23S637.33,2.3,501.54,2.56,348.75,3.4,295.42,6m5.84,903.88c-48.75-2.12-75.22-10.22-92.86-17-23.36-9-40-19.88-57.58-37.29s-28.38-34.11-37.5-57.42c-6.85-17.64-15.1-44.08-17.38-92.83-2.48-52.69-3-68.51-3.29-202s.22-149.29,2.53-202c2.08-48.71,10.23-75.21,17-92.84,9-23.39,19.84-40,37.29-57.57s34.1-28.39,57.43-37.51c17.62-6.88,44.06-15.06,92.79-17.38,52.73-2.5,68.53-3,202-3.29s149.31.21,202.06,2.53c48.71,2.12,75.22,10.19,92.83,17,23.37,9,40,19.81,57.57,37.29s28.4,34.07,37.52,57.45c6.89,17.57,15.07,44,17.37,92.76,2.51,52.73,3.08,68.54,3.32,202s-.23,149.31-2.54,202c-2.13,48.75-10.21,75.23-17,92.89-9,23.35-19.85,40-37.31,57.56s-34.09,28.38-57.43,37.5c-17.6,6.87-44.07,15.07-92.76,17.39-52.73,2.48-68.53,3-202.05,3.29s-149.27-.25-202-2.53m407.6-674.61a60,60,0,1,0,59.88-60.1,60,60,0,0,0-59.88,60.1M245.77,503c.28,141.8,115.44,256.49,257.21,256.22S759.52,643.8,759.25,502,643.79,245.48,502,245.76,245.5,361.22,245.77,503m90.06-.18a166.67,166.67,0,1,1,167,166.34,166.65,166.65,0,0,1-167-166.34" transform="translate(-2.5 -2.5)" /></svg>
          </a>
          <a id="footer-email" href="#" aria-label="Email">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1.4" y="4.9" width="21.2" height="14.2" rx="3.4" /><path d="M2.6 6.6 12 14.2l9.4-7.6" /></svg>
          </a>
        </div>
      </footer>
    </main>
    <div id="page-fade" aria-hidden="true"></div>
    <script is:inline>
      // JS-assembled mailto, same idea (and same placeholder address) as
      // the About page — TODO: swap to hello@luerwer.com together with
      // the one in contact.astro once that domain is set up.
      (() => {
        const link = document.getElementById('footer-email');
        if (link) link.href = 'mailto:' + 'simon' + '@' + 'imgs.wtf';
      })();
    </script>
    <script is:inline>
      (() => {
        const toggle = document.getElementById('menu-toggle');
        const menu = document.getElementById('mobile-menu');
        if (!toggle || !menu) return;
        const setOpen = (open) => {
          document.body.classList.toggle('menu-open', open);
          toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
          menu.setAttribute('aria-hidden', String(!open));
          // iOS Safari with viewport-fit=cover: 100vh can stop short of
          // the bottom chrome, so size the overlay from the layout
          // viewport in pixels (same trick as the lightbox).
          if (open) {
            menu.style.height =
              Math.max(document.documentElement.clientHeight, window.innerHeight) + 'px';
          }
        };
        toggle.addEventListener('click', () =>
          setOpen(!document.body.classList.contains('menu-open'))
        );
        menu.querySelectorAll('a').forEach((a) =>
          a.addEventListener('click', () => setOpen(false))
        );
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') setOpen(false);
        });
        // Rotating/resizing past the mobile breakpoint: reset cleanly.
        matchMedia('(min-width: 641px)').addEventListener('change', (e) => {
          if (e.matches) setOpen(false);
        });
        // Back/forward cache can restore the page with the menu open.
        window.addEventListener('pageshow', () => setOpen(false));
      })();
    </script>
    <script is:inline>
      // Page-fade: fades #page-fade to opaque, then navigates for real —
      // see the comment on #page-fade in the global styles for why this
      // replaced a native view-transition. Applies to any plain,
      // same-tab, same-origin link click site-wide (nav, mobile menu,
      // work covers, footer, …), so every internal navigation gets the
      // same treatment.
      (() => {
        const fade = document.getElementById('page-fade');
        if (!fade) return;
        const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const FADE_MS = reduceMotion ? 0 : 260;
        document.addEventListener('click', (e) => {
          if (e.defaultPrevented || e.button !== 0) return;
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          const link = e.target.closest('a[href]');
          if (!link) return;
          // The back-arrow prefers history.back() (own handler above);
          // new-tab and download links should behave normally.
          if (link.closest('.back-arrow')) return;
          if (link.target === '_blank' || link.hasAttribute('download')) return;
          let url;
          try {
            url = new URL(link.href, location.href);
          } catch {
            return;
          }
          if (url.origin !== location.origin) return;
          // A same-page hash link has nothing to navigate to.
          if (
            url.pathname === location.pathname &&
            url.search === location.search &&
            url.hash
          ) {
            return;
          }
          e.preventDefault();
          fade.classList.add('active');
          const go = () => {
            window.location.href = link.href;
          };
          if (FADE_MS === 0) go();
          else setTimeout(go, FADE_MS);
        });
      })();
    </script>
    {albumHeader && (
      <script is:inline>
        // Project back-arrow: send the user back to whichever listing
        // they came from (/ or /projects). Default href on the server
        // is `/` for direct landings / no-JS fallback; here we
        // override it when document.referrer says they arrived from
        // /projects. On click we prefer history.back() so scroll
        // position on the listing is preserved (and any session-
        // scoped state like the home grid's shuffle stays intact).
        (() => {
          const arrow = document.querySelector('.back-arrow');
          if (!arrow) return;
          let referrerPath = null;
          try {
            if (document.referrer) {
              const ref = new URL(document.referrer);
              if (ref.origin === location.origin) {
                referrerPath = ref.pathname.replace(/\/$/, '') || '/';
              }
            }
          } catch {}
          if (referrerPath === '/projects') arrow.href = '/projects';
          else if (referrerPath === '/') arrow.href = '/';
          arrow.addEventListener('click', (e) => {
            if (referrerPath && history.length > 1) {
              e.preventDefault();
              history.back();
            }
          });
        })();
      </script>
    )}
    <script is:inline>
      (() => {
        // Publish the nav's rendered height as a CSS variable so any
        // page can position sticky content directly below it (e.g. a
        // sticky info sidebar on series pages) without guessing a
        // fixed pixel offset — nav height changes across breakpoints
        // and with env(safe-area-inset-top) on notched devices.
        const navEl = document.querySelector('header.nav');
        const syncNavHeight = () => {
          if (navEl) {
            document.documentElement.style.setProperty(
              '--nav-h',
              navEl.getBoundingClientRect().height + 'px'
            );
          }
        };
        syncNavHeight();
        window.addEventListener('resize', syncNavHeight);
        window.addEventListener('orientationchange', syncNavHeight);

        const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const playFade = (img) => {
          img.classList.add('loaded');
          if (reduceMotion || typeof img.animate !== 'function') return;
          // The z-travel is on the tile now; per-image fade is pure
          // opacity. WAAPI is still used (instead of a CSS transition)
          // because Safari iOS skips transition interpolation on an
          // <img> that hasn't painted a prior state.
          img.animate(
            [{ opacity: 0 }, { opacity: 1 }],
            // 'backwards' keeps the start keyframe applied before play,
            // and releases the animated value after play so :hover
            // filter transitions on the image aren't pinned by WAAPI.
            { duration: 1000, easing: 'ease-out', fill: 'backwards' }
          );
        };
        const whenDecoded = (img, cb) => {
          if (typeof img.decode === 'function') img.decode().then(cb, cb);
          else cb();
        };
        const readyFor = (img) => new Promise((resolve) => {
          if (img.complete && img.naturalWidth > 0) {
            whenDecoded(img, resolve);
          } else {
            img.addEventListener('load', () => whenDecoded(img, resolve), { once: true });
            img.addEventListener('error', () => resolve(), { once: true });
          }
        });
        // Measure each drop-in tile's 2D distance from the grid center so
        // tiles closer to the center travel less on the z-axis (smaller
        // starting scale) and arrive sooner. Top-left and top-right of a
        // symmetric grid resolve to the same distance, so they animate
        // identically.
        const tiles = Array.from(document.querySelectorAll('.drop-in'));
        if (tiles.length) {
          const rects = tiles.map((t) => t.getBoundingClientRect());
          const cxs = rects.map((r) => r.left + r.width / 2);
          const cys = rects.map((r) => r.top + r.height / 2);
          const gridCx = (Math.min(...cxs) + Math.max(...cxs)) / 2;
          const gridCy = (Math.min(...cys) + Math.max(...cys)) / 2;
          const dists = rects.map((_, i) => Math.hypot(cxs[i] - gridCx, cys[i] - gridCy));
          const maxD = Math.max(...dists) || 1;
          tiles.forEach((tile, i) => {
            const n = dists[i] / maxD; // 0 = center, 1 = furthest corner
            // Scale lives on the tile again, so the range is bounded to
            // what fits in the layout gap — adjacent corner tiles can
            // both push outward at most ~5% each before they'd overlap
            // on the tightest (mobile) breakpoint.
            const scale = 1.03 + n * 0.07; // 1.03 → 1.10
            const delay = n * 240;
            tile.style.setProperty('--drop-scale', scale.toFixed(3));
            tile.style.animationDelay = delay.toFixed(0) + 'ms';
          });
        }
        requestAnimationFrame(() => document.body.classList.add('drop-ready'));

        // Fade each image in the moment it's ready. Syncing across the
        // whole grid doesn't work once loading="lazy" enters the picture —
        // off-screen images never fire a load event until you scroll, so
        // a Promise.all() gate would hang forever.
        const imgs = Array.from(document.querySelectorAll('img.img-fade'));
        imgs.forEach((img) => readyFor(img).then(() => playFade(img)));
      })();
    </script>
    <style is:global>
      /* Instrument Serif (SIL Open Font License), self-hosted rather
         than loaded from Google's servers (avoids sending visitors'
         IPs to Google — a GDPR issue for German sites). Regular weight
         only; latin covers ø/ü/é etc., latin-ext the rest. */
      @font-face {
        font-family: 'Instrument Serif';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('/fonts/InstrumentSerif-Regular-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Instrument Serif';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('/fonts/InstrumentSerif-Regular-latin-ext.woff2') format('woff2');
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }
      :root {
        /* color-scheme tells Safari which system palette the page is
           using — it's the other half of the "tint the chrome" story
           alongside <meta name=\"theme-color\">. Without it set,
           Safari ignores dynamic theme-color changes and keeps
           tinting from its own heuristic. Theme is entirely driven by
           the OS-level prefers-color-scheme media query below — no
           manual toggle, no localStorage, no JS needed before paint. */
        color-scheme: light;
        --bg: #ffffff;
        --fg: #111111;
        --muted: #666666;
        --card-bg: #e6e6e6;
        /* Translucent (not solid) — the nav uses backdrop-filter blur
           below, so this needs enough alpha to read as "frosted glass"
           over scrolled content rather than fully see-through. */
        --nav-bg: rgba(255, 255, 255, 0.72);
        --lightbox-bg: #ffffff;
        --btn-bg: rgba(0, 0, 0, 0.06);
        --btn-bg-hover: rgba(0, 0, 0, 0.12);
        --img-hover: 0.85;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          color-scheme: dark;
          --bg: #0c0c0f;
          --fg: #eaeaea;
          --muted: #8a8a90;
          --card-bg: #17171b;
          --nav-bg: rgba(12, 12, 15, 0.72);
          --lightbox-bg: #0c0c0f;
          --btn-bg: rgba(255, 255, 255, 0.08);
          --btn-bg-hover: rgba(255, 255, 255, 0.16);
          --img-hover: 1.18;
        }
      }
      * {
        box-sizing: border-box;
      }
      html {
        /* Reserve space for the scrollbar gutter even when content
           doesn't overflow yet — keeps the layout from shifting
           horizontally when the lightbox toggles `body { overflow:
           hidden }`. Supported in Chromium 94+, Firefox 97+, Safari
           18.2+. The Lightbox script also pads the body by the
           measured scrollbar width as a fallback for older Safari. */
        scrollbar-gutter: stable;
      }
      html, body {
        margin: 0;
        padding: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'Helvetica Neue', Arial, sans-serif;
        -webkit-font-smoothing: antialiased;
        /* Matches frankmorlok.com's CSS: a simple 300ms ease-in-out
           crossfade. Safari iOS's chrome lags slightly because it
           convolves the sample with its own smoothing, but this is
           the best pure-CSS match we've found. */
        transition: background-color 300ms ease-in-out, color 300ms ease-in-out;
      }
      /* Page-fade overlay: we tried the browser's native cross-document
         view-transition for this, twice, and both attempts produced
         real rendering bugs on WebKit (a stale-page flash, then
         magenta streaking) once the mobile menu's masked overlay and
         the grid's own entrance animations got involved — the native
         feature captures whole-page screenshots and composites them in
         ways we don't fully control. This does the same job with a
         plain, fully-owned opacity transition instead: fade this page
         to the background colour, then navigate for real. The
         destination page loads fresh and plays its own entrance
         animations (drop-in tiles, image fade-in) exactly as it always
         has — nothing to fight with. See the click-handling script
         further down for the other half of this. */
      #page-fade {
        position: fixed;
        inset: 0;
        z-index: 500;
        background: var(--bg);
        opacity: 0;
        pointer-events: none;
        transition: opacity 260ms ease;
      }
      #page-fade.active {
        opacity: 1;
      }
      @media (prefers-reduced-motion: reduce) {
        #page-fade { transition: none; }
      }
      @keyframes drop-in {
        0% {
          opacity: 0;
          transform: scale(var(--drop-scale, 1.08));
          filter: blur(3px);
        }
        70% {
          filter: blur(0);
        }
        100% {
          opacity: 1;
          transform: scale(1);
          filter: blur(0);
        }
      }
      .drop-in {
        animation: drop-in 1200ms cubic-bezier(0.22, 1, 0.36, 1) both;
        animation-play-state: paused;
        transform-origin: center center;
        will-change: transform, opacity, filter;
      }
      body.drop-ready .drop-in {
        animation-play-state: running;
      }
      .img-fade {
        opacity: 0;
        will-change: opacity, filter, transform;
      }
      .img-fade.loaded {
        opacity: 1;
      }
      @media (prefers-reduced-motion: reduce) {
        .drop-in { animation: none; }
        .img-fade { opacity: 1; }
      }
      a {
        color: inherit;
        text-decoration: none;
      }
      .nav {
        position: sticky;
        top: 0;
        z-index: 10;
        /* Translucent + blurred now that there's no in-page theme
           toggle. The blur was previously dropped because an in-page
           JS-triggered light/dark flip froze iOS Safari's URL-bar
           chrome-tint sampling (a compositor quirk on 26). Without a
           manual toggle that specific trigger is gone — the only way
           the scheme changes now is the OS setting itself flipping
           while the tab is open, a far rarer event than a toggle
           click, so the trade-off is worth it for the nicer look. */
        background: var(--nav-bg);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        transition: background-color 300ms ease-in-out;
      }
      .nav-inner {
        /* Full-width nav: the inner row inherits the same horizontal
           rhythm as <main> so the brand on the left and the links on
           the right line up with the grid edges. No max-width — the
           nav stretches the full viewport, padding does the spacing. */
        /* safe-area-inset-top pushes the nav content below the iOS
           notch/status bar now that viewport-fit=cover extends the
           page background all the way to the device edge. Horizontal
           insets cover landscape notches. */
        padding: calc(20px + env(safe-area-inset-top)) calc(80px + env(safe-area-inset-right)) 20px calc(80px + env(safe-area-inset-left));
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 16px;
      }
      .nav-left {
        position: relative;
        display: flex;
        align-items: center;
        min-width: 0;
      }
      .nav-center {
        justify-self: center;
        color: var(--muted);
        font-size: 14px;
      }
      .nav-right {
        justify-self: end;
        display: flex;
        align-items: center;
        gap: 22px;
      }
      .nav-links {
        display: flex;
        align-items: center;
        gap: 18px;
        font-size: 14px;
      }
      .nav-link {
        color: var(--muted);
        transition: color 150ms ease;
        letter-spacing: -0.005em;
        white-space: nowrap;
      }
      .nav-link:hover {
        color: var(--fg);
      }
      /* The active link stays at font-weight 400 so its glyph metrics
         (and therefore the link's box width) never change — a bumped
         font-weight would reflow the neighbours even with a reserved-
         width pseudo-element, because the font stack's 500 variant
         advances slightly differently. Instead, a two-axis text-shadow
         of currentColor fakes the added weight visually: the shadow
         adds paint, not layout. */
      .nav-link.active {
        color: var(--fg);
        text-shadow:
          0.3px 0 0 currentColor,
          -0.3px 0 0 currentColor;
      }
      .brand {
        font-weight: 600;
        letter-spacing: -0.01em;
        font-size: 15px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .back-arrow {
        position: absolute;
        right: calc(100% + 20px);
        top: 50%;
        transform: translateY(-50%);
        color: var(--fg);
        font-size: 18px;
        line-height: 1;
        font-weight: 400;
        transition: opacity 150ms ease;
      }
      .back-arrow:hover {
        opacity: 0.6;
      }
      main {
        /* Full-width on desktop with 80px L/R breathing room. No
           max-width — the grid expands to fill the viewport so the
           images themselves get bigger, not the count per row. */
        padding: 0 80px 192px;
        /* Always taller than the viewport, so the imprint link (pinned
           to main's bottom edge below) is below the fold on every page
           — even short ones like about-me — and never visible without
           scrolling. The extra 32px covers the nav sitting above main,
           which pushes main's bottom further down still. */
        position: relative;
        min-height: calc(100vh + 32px);
      }
      .site-footer {
        /* Absolutely pinned to the bottom of main's padding area so it
           sits at the very end of the page whether the content is short
           or long (main's bottom padding reserves its room, so it never
           overlaps content). Centred: the imprint link, with the social
           icons on a row underneath. */
        position: absolute;
        left: 80px;
        right: 80px;
        bottom: 32px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 22px;
      }
      .footer-imprint {
        color: var(--muted);
        font-size: 13px;
        transition: color 150ms ease;
      }
      .footer-imprint:hover {
        color: var(--fg);
      }
      .footer-icons {
        display: flex;
        gap: 22px;
      }
      .footer-icons a {
        display: block;
        width: 22px;
        height: 22px;
        color: var(--fg);
        transition: opacity 150ms ease;
      }
      .footer-icons a:hover {
        opacity: 0.6;
      }
      .footer-icons svg {
        display: block;
        width: 100%;
        height: 100%;
      }
      /* ---- Mobile menu (burger + full-screen overlay) ----
         Only exists at <=640px; hidden entirely on desktop. */
      .menu-toggle,
      .mobile-menu {
        display: none;
      }
      .menu-toggle {
        position: relative;
        width: 44px;
        height: 36px;
        /* Negative margins: keeps the 44x36 hit target without making
           the nav row any taller, and lets the icon's right edge line
           up with the page margin. */
        margin: -8px -12px -8px 0;
        padding: 0;
        border: none;
        background: transparent;
        color: var(--fg);
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
      }
      .menu-toggle span {
        position: absolute;
        left: 12px;
        right: 12px;
        top: calc(50% - 1px);
        height: 2px;
        background: currentColor;
        transition: transform 560ms cubic-bezier(0.65, 0, 0.35, 1);
      }
      .menu-toggle span:nth-child(1) { transform: translateY(-4px); }
      .menu-toggle span:nth-child(2) { transform: translateY(4px); }
      body.menu-open .menu-toggle span:nth-child(1) { transform: rotate(45deg); }
      body.menu-open .menu-toggle span:nth-child(2) { transform: rotate(-45deg); }
      body.menu-open { overflow: hidden; }
      /* While open, the header rises above the overlay (so the brand
         and the burger-turned-X stay visible and tappable) and drops
         its own background/blur so it blends into the overlay. */
      body.menu-open .nav {
        z-index: 95;
        background: transparent;
        -webkit-backdrop-filter: none;
        backdrop-filter: none;
      }
      /* The reveal is a radial mask with a wide FEATHERED edge (not a
         hard clip-path circle), growing from the burger while the
         whole overlay also fades in — so it reads as a soft wash of
         colour spreading across the screen rather than a geometric
         disc. --menu-r is a registered length so it can be animated. */
      @property --menu-r {
        syntax: '<length>';
        inherits: false;
        initial-value: 0px;
      }
      .mobile-menu {
        --menu-r: 0px;
        --menu-origin: calc(100% - 26px) calc(env(safe-area-inset-top) + 27px);
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100vh; /* refined in JS from clientHeight — see script */
        z-index: 90;
        flex-direction: column;
        justify-content: space-between;
        padding: calc(var(--nav-h, 64px) + 40px) 16px max(32px, calc(env(safe-area-inset-bottom) + 24px));
        background: var(--bg);
        overflow-y: auto;
        visibility: hidden;
        opacity: 0;
        -webkit-mask-image: radial-gradient(circle at var(--menu-origin), #000 calc(var(--menu-r) - 240px), transparent var(--menu-r));
        mask-image: radial-gradient(circle at var(--menu-origin), #000 calc(var(--menu-r) - 240px), transparent var(--menu-r));
        transition:
          --menu-r 900ms cubic-bezier(0.65, 0, 0.35, 1),
          opacity 700ms ease,
          visibility 0s linear 900ms;
      }
      body.menu-open .mobile-menu {
        --menu-r: 220vmax;
        visibility: visible;
        opacity: 1;
        transition:
          --menu-r 900ms cubic-bezier(0.65, 0, 0.35, 1),
          opacity 700ms ease,
          visibility 0s;
      }
      .mobile-menu a {
        display: block;
        color: var(--fg);
        opacity: 0;
        transform: translateY(16px);
        transition: opacity 250ms ease, transform 250ms ease;
      }
      body.menu-open .mobile-menu a {
        opacity: 1;
        transform: none;
        /* Links rise in one after another once the wash is well
           underway. Closing has no delay (see the base rule). */
        transition:
          opacity 600ms ease calc(520ms + var(--i, 0) * 90ms),
          transform 700ms cubic-bezier(0.2, 0.8, 0.2, 1) calc(520ms + var(--i, 0) * 90ms);
      }
      .menu-primary a {
        font-size: 40px;
        font-weight: 600;
        letter-spacing: -0.03em;
        line-height: 1.25;
        padding: 6px 0;
      }
      /* Bottom row: Instagram glyph bottom-left, Imprint bottom-right
         (DOM order is imprint first, so the glyph is reordered). */
      .menu-secondary {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .menu-secondary a {
        font-size: 16px;
        color: var(--muted);
        padding: 8px 0;
      }
      /* Instagram glyph: fills with the foreground colour (near-black
         in light mode; flips to light in dark mode so it stays visible). */
      .menu-secondary a.menu-ig {
        order: -1;
        color: var(--fg);
        width: 22px;
        padding: 8px 0;
        box-sizing: content-box;
      }
      .menu-ig svg {
        display: block;
        width: 22px;
        height: 22px;
      }
      @media (prefers-reduced-motion: reduce) {
        .mobile-menu,
        body.menu-open .mobile-menu {
          --menu-r: 220vmax;
          transition: opacity 200ms ease, visibility 0s linear 200ms;
        }
        body.menu-open .mobile-menu {
          transition: opacity 200ms ease, visibility 0s;
        }
        .mobile-menu a,
        body.menu-open .mobile-menu a {
          opacity: 1;
          transform: none;
          transition: none;
        }
        .menu-toggle span { transition: none; }
      }
      @media (max-width: 1100px) {
        /* Tighten the side rails as the viewport narrows so 80px
           doesn't eat too much of a smaller screen. */
        .nav-inner {
          padding: calc(20px + env(safe-area-inset-top)) calc(40px + env(safe-area-inset-right)) 20px calc(40px + env(safe-area-inset-left));
        }
        main { padding: 0 40px 192px; }
        .site-footer { left: 40px; right: 40px; }
      }
      @media (max-width: 640px) {
        /* Let the right column size to its content so the links and
           toggle always sit flush against the right edge; the brand
           gets whatever space is left and truncates with an ellipsis
           if the viewport is too narrow. The 1fr ensures there's
           always a gap between the brand and the first nav link. */
        .nav-inner {
          /* Same safe-area treatment as desktop but with the tighter
             mobile base paddings (16px all around). */
          padding: calc(16px + env(safe-area-inset-top)) calc(16px + env(safe-area-inset-right)) 16px calc(16px + env(safe-area-inset-left));
          gap: 12px;
          grid-template-columns: minmax(0, 1fr) auto auto;
        }
        main { padding: 0 16px 170px; }
        .site-footer { left: 16px; right: 16px; bottom: 24px; }
        .nav-left { gap: 12px; }
        .back-arrow {
          position: static;
          transform: none;
        }
        .nav-right { gap: 14px; }
        /* Nav links give way to the burger + full-screen menu. */
        .nav-links { display: none; }
        .menu-toggle { display: block; }
        .mobile-menu { display: flex; }
        /* Album count hides on narrow screens so the nav links and
           album title both have room to breathe. */
        .nav-center { display: none; }
        .brand { font-size: 14px; }
      }
    </style>
  </body>
</html>
